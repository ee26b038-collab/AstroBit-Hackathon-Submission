def run_split(directory):
    out = []
    paths = sorted(glob.glob(f"{directory}/*.parquet"))
    
    if len(paths) == 0:
        print(f"\n❌ ERROR: No .parquet files found in directory: {directory}")
        print("Please check your PRIVATE_DIR path assignment string closely.")
        return pd.DataFrame()

    for i, path in enumerate(paths, 1):
        sid = os.path.basename(path)[:-8]
        try:
            t_i, f_i, q_i = iterative_clean(pd.read_parquet(path))
            if t_i is None:
                raise ValueError("Too few good cadences available")
            cand = search(t_i, f_i)
            feat_row = extract_features(t_i, f_i, q_i, cand)
            conf = float(clf.predict_proba(pd.DataFrame([feat_row])[FEATURE_COLS])[0, 1])
        except Exception as e:
            print(f"  Star {sid} analysis failed: {e}")
            cand = {"period": np.nan, "depth_ppm": np.nan, "duration_hours": np.nan, "sde": 0.0}
            conf = 0.0

        hit = conf > CONFIDENCE_THRESHOLD
        
        out.append({
            "star_id": sid,
            "prediction": int(hit),
            "confidence": round(conf, 4),
            "period": round(cand["period"], 5) if hit else None,
            "depth_ppm": round(cand["depth_ppm"], 1) if hit else None,
            "duration_hours": round(cand["duration_hours"], 3) if hit else None,
        })
        if i % 10 == 0 or i == len(paths):
            print(f"  [Private Processing Progress: {i}/{len(paths)}]", flush=True)
            
    return pd.DataFrame(out)


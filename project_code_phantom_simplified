def _phase(t, t0, period):
    ph = ((t - t0) / period) % 1.0
    return np.where(ph > 0.5, ph - 1, ph)

def odd_even_consistency(t, f, period, t0, duration_hours):
    half_dur = (duration_hours / 24) / 2
    cycle = np.floor((t - t0) / period + 0.5)
    ph = _phase(t, t0, period)
    in_transit = np.abs(ph) < half_dur

    odd = in_transit & (cycle % 2 == 1)
    even = in_transit & (cycle % 2 == 0)
    if odd.sum() < 3 or even.sum() < 3:
        return np.nan

    baseline_flux = np.median(f[~in_transit])
    depth_odd = baseline_flux - np.median(f[odd])
    depth_even = baseline_flux - np.median(f[even])
    if depth_odd <= 0 or depth_even <= 0:
        return np.nan
    return float(abs(depth_odd - depth_even) / max(depth_odd, depth_even))

def secondary_eclipse_depth_ppm(t, f, period, t0, duration_hours):
    half_dur = (duration_hours / 24) / 2
    ph = _phase(t, t0, period)
    secondary_mask = np.abs(np.abs(ph) - 0.5) < half_dur
    out_mask = np.abs(ph) > 3 * half_dur
    if secondary_mask.sum() < 3 or out_mask.sum() < 10:
        return np.nan
    return float((np.median(f[out_mask]) - np.median(f[secondary_mask])) * 1e6)

def quarter_recurrence(t, f, quarter, period, t0, duration_hours):
    half_dur = (duration_hours / 24) / 2
    ph = _phase(t, t0, period)
    in_transit = np.abs(ph) < half_dur

    hits, total = 0, 0
    for qq in np.unique(quarter):
        s = quarter == qq
        if in_transit[s].sum() < 2:
            continue  # this quarter never actually covered a transit
        total += 1
        out_of_transit = np.median(f[s & ~in_transit])
        in_t = np.median(f[s & in_transit])
        if out_of_transit - in_t > 0:
            hits += 1
    return hits / total if total > 0 else np.nan

FEATURE_COLS = ["sde", "depth_ppm", "duration_hours",
                "odd_even_frac_diff", "secondary_depth_ppm", "quarter_recurrence"]

def extract_features(t, f, q, candidate):
    period, t0, duration_hours = candidate["period"], candidate["t0"], candidate["duration_hours"]
    if not np.isfinite(period):
        return {c: np.nan for c in FEATURE_COLS} | {"sde": candidate.get("sde", 0.0)}
    return {
        "sde": candidate["sde"],
        "depth_ppm": candidate["depth_ppm"],
        "duration_hours": duration_hours,
        "odd_even_frac_diff": odd_even_consistency(t, f, period, t0, duration_hours),
        "secondary_depth_ppm": secondary_eclipse_depth_ppm(t, f, period, t0, duration_hours),
        "quarter_recurrence": quarter_recurrence(t, f, q, period, t0, duration_hours),
    }


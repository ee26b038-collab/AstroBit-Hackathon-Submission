PERIOD_MIN = 3.0
PERIOD_MAX = 400.0
N_COARSE = 20000       
N_PEAKS = 8            
N_FINE = 600          
N_COARSE_QUICK = 3000 
DURATIONS = np.array([0.05, 0.1, 0.2, 0.4, 0.8])  # days

def sde(power, i):
    med = np.nanmedian(power)
    mad = np.nanmedian(np.abs(power - med))
    return float((power[i] - med) / (1.4826 * mad)) if mad > 0 else 0.0

def quick_search(t, f):
    t_fast = t[::3]
    f_fast = f[::3]
    
    if len(t_fast) < 300:
        t_fast, f_fast = t, f

    bls = BoxLeastSquares(t_fast, f_fast)
    baseline = t_fast.max() - t_fast.min()
    pmax = min(PERIOD_MAX, baseline / 3.0)
    coarse = np.exp(np.linspace(np.log(PERIOD_MIN), np.log(pmax), N_COARSE_QUICK))
    
    res = bls.power(coarse, DURATIONS, objective="likelihood")
    power = np.asarray(res.power)
    i = int(np.nanargmax(power))
    return {
        "period": float(res.period[i]),
        "t0": float(res.transit_time[i]),
        "duration_hours": float(res.duration[i] * 24),
        "sde": sde(power, i),
    }

def search(t, f, verbose=False):
    bls = BoxLeastSquares(t, f)
    baseline = t.max() - t.min()
    pmax = min(PERIOD_MAX, baseline / 3.0)

    coarse = np.exp(np.linspace(np.log(PERIOD_MIN), np.log(pmax), N_COARSE))
    res = bls.power(coarse, DURATIONS, objective="likelihood")
    power = np.asarray(res.power)

    order = np.argsort(power)[::-1]
    peaks, used = [], np.zeros(len(coarse), bool)
    for i in order:
        if used[i]:
            continue
        peaks.append(i)
        lo = np.searchsorted(coarse, coarse[i] * 0.9)
        hi = np.searchsorted(coarse, coarse[i] * 1.1)
        used[lo:hi] = True
        if len(peaks) >= N_PEAKS:
            break

    best = None
    for i in peaks:
        p0 = coarse[i]
        width = 0.02 * p0
        fine = np.linspace(p0 - width, p0 + width, N_FINE)
        fine = fine[fine > PERIOD_MIN]
        if len(fine) < 10:
            continue

        r = bls.power(fine, DURATIONS, objective="likelihood")
        p = np.asarray(r.power)
        j = int(np.nanargmax(p))
        score = sde(power, i)

        if best is None or score > best["sde"]:
            best = {
                "period": float(r.period[j]),
                "depth_ppm": float(r.depth[j] * 1e6),
                "duration_hours": float(r.duration[j] * 24),
                "t0": float(r.transit_time[j]),
                "sde": score,
            }
        if verbose:
            print(f"  peak P={p0:8.3f} -> refined {r.period[j]:8.4f}  SDE {score:5.1f}")

    return best or {"period": np.nan, "depth_ppm": np.nan, "duration_hours": np.nan, "t0": np.nan, "sde": 0.0}
DETREND_WINDOW_DAYS = 1.0

def load_and_normalise(df):
    m = (df.quality.values == 0) & np.isfinite(df.flux.values)
    t = df.time.values[m]
    f = df.flux.values[m].astype(float)
    q = df.quarter.values[m]
    if len(t) < 1000:
        return None, None, None

    for qq in np.unique(q):
        s = q == qq
        med = np.median(f[s])
        f[s] = f[s] / med if med > 0 else 1.0

    order = np.argsort(t)
    return t[order], f[order], q[order]

def fit_trend(t, f, window_days, mask_transit=None, method="savgol"):
    cadence = np.median(np.diff(t))
    k = max(7, int(window_days / cadence) | 1)

    fit_input = f.copy()
    if mask_transit is not None and mask_transit.any():
        fit_input[mask_transit] = np.nan
        fit_input = pd.Series(fit_input).interpolate(limit_direction="both").values

    if method == "savgol":
        polyorder = min(2, k - 1)
        trend = savgol_filter(fit_input, k, polyorder, mode="interp")
    else:
        trend = pd.Series(fit_input).rolling(k, center=True, min_periods=k // 3).median().values

    return trend

def iterative_clean(df, window_days=DETREND_WINDOW_DAYS, n_iter=2, quick_sde_floor=5.0):
    t, f, q = load_and_normalise(df)
    if t is None:
        return None, None, None

    mask_transit = None
    for iteration in range(n_iter):
        trend = fit_trend(t, f, window_days, mask_transit=mask_transit)
        ok = np.isfinite(trend) & (trend > 0)
        t_i, f_i = t[ok], f[ok] / trend[ok]

        if iteration > 0 and mask_transit is not None and not mask_transit.any():
            break

        quick = quick_search(t_i, f_i)
        if quick["sde"] < quick_sde_floor:
            break

        half_dur_phase = (quick["duration_hours"] / 24) / quick["period"] / 2
        ph = ((t - quick["t0"]) / quick["period"]) % 1.0
        ph = np.where(ph > 0.5, ph - 1, ph)
        mask_transit = np.abs(ph) < (half_dur_phase * 1.5)

    trend = fit_trend(t, f, window_days, mask_transit=mask_transit)
    ok = np.isfinite(trend) & (trend > 0)
    return t[ok], f[ok] / trend[ok], q[ok]

